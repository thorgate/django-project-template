FROM docker:latest

RUN apk update && \
    apk upgrade && \
    apk add python3 python3-dev build-base libffi-dev openssl-dev git bash rust cargo && \
    apk add yq --repository http://dl-3.alpinelinux.org/alpine/edge/community/

# Remove EXTERNALLY-MANAGED files to allow for poetry installer to work
RUN find / -name EXTERNALLY-MANAGED -exec rm -f {} \; || true
RUN python3 -m ensurepip

# As CI docker image is based on alpine and we generate lock file outside of docker then
#  we need system libraries required for pip dependencies.
RUN apk add postgresql-dev
RUN pip3 install -U pip 'pipenv>=2020.6.2' setuptools wheel

ENV POETRY_HOME="$HOME/.poetry"
ENV POETRY_NO_INTERACTION=1
ENV POETRY_VERSION="2.4.1"

RUN wget -O - -o /dev/null https://install.python-poetry.org | python3 -
ENV PATH="$POETRY_HOME/bin:$VENV_PATH/bin:$PATH"

RUN apk add just

# Helm CLI, used by the KUBERNETES test to `helm template` the generated
# helm_deploy scaffold against the phoenix chart. Pinned so it doesn't drift.
ENV HELM_VERSION="v3.16.4"
RUN wget -O - -o /dev/null https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz \
    | tar -xz -C /tmp && \
    mv /tmp/linux-amd64/helm /usr/local/bin/helm && \
    rm -rf /tmp/linux-amd64 && \
    helm version

# kustomize CLI, used by the KUBERNETES test to build the helm_deploy/dev/extra
# overlay (namespace + config + movetokube CRs + image-updater CR). Pinned.
ENV KUSTOMIZE_VERSION="v5.5.0"
RUN wget -O /tmp/kustomize.tgz -o /dev/null \
    "https://github.com/kubernetes-sigs/kustomize/releases/download/kustomize%2F${KUSTOMIZE_VERSION}/kustomize_${KUSTOMIZE_VERSION}_linux_amd64.tar.gz" && \
    tar -xz -C /usr/local/bin -f /tmp/kustomize.tgz kustomize && \
    rm /tmp/kustomize.tgz && \
    kustomize version
