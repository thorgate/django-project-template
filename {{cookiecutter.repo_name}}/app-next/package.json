{
  "name": "{{cookiecutter.project_title}}",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate-env": "node ./scripts/generate-env.js",
    "dev": "pnpm generate-env && next dev",
    "build": "next build",
    "start": "pnpm generate-env && next start",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint:eslint": "eslint --max-warnings 0 .",
    "lint:tsc": "tsc --noEmit",
    "lint": "pnpm lint:eslint && pnpm lint:tsc",
    "prettier-check": "prettier --check",
    "prettier-check-all": "prettier --check '{lib,src,app,__tests__,components,pages,scripts,types}/**/*.{js,jsx,ts,tsx}'",
    "prettier-format": "prettier --write",
    "prettier-format-all": "prettier --write '{lib,src,app,__tests__,components,pages,scripts,types}/**/*.{js,jsx,ts,tsx}'",
    {%- if cookiecutter.use_cypress == YES %}
    "cy:run-ci": "wait-on http://node-cypress.TODO.com.docker.local:9990 && cypress run --browser chrome --headless",
    "cy:run": "cypress run --browser chrome",
    "cy:open": "cypress open",
    {%- endif %}
    "generate-api": "pnpm rtk-query-codegen-openapi ./lib/queries/openapiConfig.ts && pnpm prettier-format-all",
    "generate-api-mock": "pnpm msw-auto-mock lib/queries/schema.json -o mock/api/handlers.generated.js && pnpm prettier-format-all",
    "extract-i18n": "i18next-scanner --config ./scanner.config.js",
    "postextract-i18n": "pnpm i18next-resources",
    "i18next-resources": "i18next-resources-for-ts interface -i ./public/locales/en -o ./types/i18next-resources.d.ts && prettier --write ./types/i18next-resources.d.ts"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.5.0",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "@sentry/nextjs": "^10.0.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.0.0",
    "dotenv-expand": "^13.0.0",
    "i18next": "^26.0.0",
    "i18next-chained-backend": "^5.0.0",
    "i18next-http-backend": "^4.0.0",
    "i18next-localstorage-backend": "^4.2.0",
    "i18next-resources-for-ts": "^2.0.0",
    "i18next-scanner": "^4.6.0",
    "jose": "^6.0.0",
    "lodash.debounce": "^4.0.8",
    "lodash.throttle": "^4.1.1",
    "lorem-ipsum": "^3.0.0",
    "minimist": "^1.2.8",
    "next": "^16.0.0",
    "next-auth": "^4.24.11",
    "next-i18next": "^16.0.0",
    "next-redux-wrapper": "9.0.0-rc.2",
    "numeral": "^2.0.6",
    "openapi-types": "12.1.3",
    "qs": "^6.13.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.76.0",
    "react-i18next": "^17.0.0",
    "react-number-format": "^5.4.3",
    "react-redux": "^9.2.0",
    "react-toastify": "^11.0.2",
    "redux": "^5.0.1",
    "redux-logger": "^3.0.6"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@eslint-react/eslint-plugin": "^5.8.1",
    "@faker-js/faker": "^10.0.0",
    "@next/eslint-plugin-next": "^16.0.0",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jest": "^30.0.0",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^25.0.0",
    "@types/numeral": "^2.0.2",
    "@types/qs": "^6.9.7",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "@types/redux-logger": "^3.0.9",
    "cross-fetch": "^4.1.0",
    {%- if cookiecutter.use_cypress == YES %}
    "cypress": "^12.9.0",
    "cypress-multi-reporters": "^1.6.3",
    {%- endif %}
    "eol": "^0.10.0",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import-x": "^4.16.2",
    "jest": "^30.0.0",
    "lodash.merge": "^4.6.2",
    "jest-environment-jsdom": "^30.0.0",
    "jest-junit": "^17.0.0",
    {%- if cookiecutter.use_cypress == YES %}
    "mocha": "^10.2.0",
    {%- endif %}
    "msw": "^1.2.2",
    "msw-auto-mock": "^0.15.0",
    "postcss": "^8.4.21",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "vinyl": "^3.0.1",
    "ts-node": "^10.9.2",
    "typescript-eslint": "^8.0.0",
    "wait-on": "^9.0.0"
  }
}
