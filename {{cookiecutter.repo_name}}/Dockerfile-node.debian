FROM node:{{ cookiecutter.node_version }}-bookworm-slim

# Install system requirements
# Use non-interactive frontend for debconf
RUN echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections

# Install system requirements
RUN apt-get update && \
    apt-get install -y --no-install-recommends git python3 python-is-python3 && \
    rm -rf /var/lib/apt/lists/* && \
    npm -g i pnpm@^{% if cookiecutter.node_version|int >= 22 %}11{% else %}10{% endif %} && \
    pnpm config set store-dir /usr/local/share/.cache/.pnpm-store

# - {% if cookiecutter.frontend_style == WEBAPP %}
ENV WDS_PROXY_TARGET="http://django:80/"
# - {% endif %}

# Set the default directory where CMD will execute
WORKDIR /app

# Set the default command to execute when creating a new container
COPY scripts/node-dev-entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh", "--"]
CMD bash
